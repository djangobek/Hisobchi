DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/hisobchi?schema=public"
BOT_TOKEN="SET_FROM_TELEGRAM_BOTFATHER"
WEB_APP_URL="https://your-deployed-mini-app.example"
ADMIN_TELEGRAM_IDS="YOUR_TELEGRAM_ID"
TELEGRAM_INIT_DATA_MAX_AGE_SECONDS="86400"
NODE_ENV="development"
NEXT_PUBLIC_BOT_URL="https://t.me/your_bot"

# ---- Ovoz -> matn (STT). Tartib: Muxlisa AI (asosiy) -> ElevenLabs (faqat zaxira) ----
MUXLISA_API_KEY=""
# Ixtiyoriy: Muxlisa hujjatidagi endpoint/maydon nomi farq qilsa
# MUXLISA_STT_URL="https://service.muxlisa.uz/api/v2/stt"
# MUXLISA_AUDIO_FIELD="audio"
ELEVENLABS_API_KEY=""
ELEVENLABS_STT_MODEL="scribe_v1"
# uz (standart) | auto (avtomatik aniqlash). Interfeysi ruscha foydalanuvchilar uchun doim avtomatik.
ELEVENLABS_STT_LANGUAGE="uz"

# ---- Matn -> operatsiyalar (NLU). Tartib: Groq (yagona AI) -> lokal parser (kalitsiz ham ishlaydi) ----
GROQ_API_KEY=""
# Vergul bilan bir nechta model: birinchisi topilmasa keyingisi ishlatiladi
GROQ_MODEL="openai/gpt-oss-120b,llama-3.3-70b-versatile"

# ---- Web-ilovadagi "Hisobchi AI" bo'limi (botga aloqasi yo'q; bot Gemini ishlatmaydi) ----
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# ---- Bot sozlamalari (ixtiyoriy) ----
# Qattiq limit: shundan uzun ovoz rad etiladi
VOICE_MAX_SECONDS="60"
# Shundan uzun ovozda aniq ogohlantirish ko'rsatiladi (rad etilmaydi)
VOICE_WARN_SECONDS="15"
DRAFT_TTL_MINUTES="15"
BOT_RATE_LIMIT_PER_MINUTE="8"
REMINDER_HOUR="21"
DEBT_REMINDER_HOUR="9"

# ---- Telegram HTML Widgets (Bot API 10.4 beta/experimental) ----
# Enable only after your bot can access Telegram's Bot API beta endpoint.
WIDGETS_ENABLED="false"
TELEGRAM_BOT_API_BASE_URL="https://api.telegram.org/beta"
